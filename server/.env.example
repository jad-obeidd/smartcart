PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/smartcart
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=change-me
CLIENT_ORIGIN=http://localhost:5173
# Optional - without it SmartCart uses rule-based search, list generation and recommendations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# How often the simulated price feed updates (ms)
PRICE_TICK_MS=15000
